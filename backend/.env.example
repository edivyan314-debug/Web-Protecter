# Backend Environment Variables (Render Deployment)
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/web_protector?retryWrites=true&w=majority

# Allowed frontend origin for CORS (e.g. your Vercel deployment URL)
FRONTEND_URL=http://localhost:5173
